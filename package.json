{
  "name": "paperclip-companion",
  "version": "0.0.0",
  "private": true,
  "description": "Independent Windows-first desktop helper",
  "type": "module",
  "main": "dist/main/index.cjs",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "electron": "44.7.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.main.config.ts",
    "start": "npm run build && electron .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run check:licenses",
    "check:licenses": "node scripts/license-check.ts"
  }
}
